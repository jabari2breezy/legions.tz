# Set these in Vercel → Project Settings → Environment Variables. Never commit real values.
RESEND_API_KEY=re_your_resend_api_key
# Must be a verified sender in your Resend account, e.g. Legions <hello@legions.tz>
RESEND_FROM_EMAIL=Legions <hello@legions.tz>
GOOGLE_SERVICE_ACCOUNT_EMAIL=volunteer-form@your-google-project.iam.gserviceaccount.com
# Keep the literal \n sequences from the Google service-account JSON private_key value.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
GOOGLE_SHEET_ID=16gcDtan5zGQWZ1FB7CjUUUkNZXNR_4QDJDgUfxpeZ7U
# Optional: this is automatically discovered from the supplied gid if omitted.
GOOGLE_SHEET_TAB=
